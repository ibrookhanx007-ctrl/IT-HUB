# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored — never commit real secrets.

# Resend API key used to send contact form notifications.
# Create one at https://resend.com/api-keys (see the "Resend setup"
# instructions from the engineer who set this up, or AGENTS.md history).
RESEND_API_KEY=

# Inbox that receives contact form submissions. Can differ from the
# email address shown publicly in src/content/site.ts.
CONTACT_EMAIL_TO=

# "From" address used when sending contact form notifications via
# Resend. Must be on a domain verified in the Resend dashboard — until
# a domain is verified, use Resend's test address
# "onboarding@resend.dev" for development.
CONTACT_EMAIL_FROM=
